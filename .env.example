JWT_SECRET="change-me-arta-prod-secret"
JWT_EXPIRES_IN="7d"
API_PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000"
UPLOAD_DIR="./uploads"
SEED_PASSWORD="ArtaDevLocal-1"
# Si defines SEED_PASS_*, tienen prioridad sobre SEED_PASSWORD:
SEED_PASS_ARTURO="CambiaEsto-Arturo"
SEED_PASS_CHACHO="CambiaEsto-Chacho"
SEED_PASS_MELISSA="CambiaEsto-Melissa"
SEED_PASS_RODRIGO="CambiaEsto-Rodrigo"
SEED_PASS_WILLIAMS="CambiaEsto-Williams"
SEED_PASS_LEIDA="CambiaEsto-Leida"
SEED_PASS_JP="CambiaEsto-Jp"

# Dominios panel (SSO cross-subdomain)
NEXT_PUBLIC_ROOT_DOMAIN="artaproducciones.com"
NEXT_PUBLIC_ARTA_HOST="arta.artaproducciones.com"
NEXT_PUBLIC_AUDITORIO_HOST="auditorio.artaproducciones.com"

# Avisos push del navegador (FCM web, proyecto arta-app-fde07). Vacías = la función se oculta.
# Requiere registrar la app web en Firebase console: Configuración del proyecto -> Tus apps -> Web
# (de ahí salen API key, sender ID y app ID). La VAPID key sale de Configuración del proyecto ->
# Cloud Messaging -> Certificados push web. Son públicas, pero se inyectan en el build (no en runtime).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
