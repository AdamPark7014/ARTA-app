POSTGRES_USER=arta
POSTGRES_PASSWORD=change-me-strong-db-pass
POSTGRES_DB=arta
JWT_SECRET=change-me-arta-prod-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d
SEED_PASSWORD=ArtaDevLocal-1
SEED_PASS_ARTURO=CambiaEsto-Arturo
SEED_PASS_CHACHO=CambiaEsto-Chacho
SEED_PASS_RODRIGO=CambiaEsto-Rodrigo
SEED_PASS_WILLIAMS=CambiaEsto-Williams
SEED_PASS_LEIDA=CambiaEsto-Leida
SEED_PASS_JP=CambiaEsto-Jp
# Altas de la junta 2026-08-28
SEED_PASS_MONSE=CambiaEsto-Monse
SEED_PASS_MARISOL=CambiaEsto-Marisol
SEED_PASS_KIKA=CambiaEsto-Kika
NEXT_PUBLIC_ROOT_DOMAIN=artaproducciones.com
NEXT_PUBLIC_ARTA_HOST=arta.artaproducciones.com
NEXT_PUBLIC_AUDITORIO_HOST=auditorio.artaproducciones.com
# SEO / verificación (opcional — Adam confirma URLs redes). Van al BUILD de web (NEXT_PUBLIC_*):
# tras cambiarlas hay que reconstruir la imagen. Redes: URL https completa; se muestran en el pie y
# entran a sameAs del JSON-LD. Ver docs/seo/GOOGLE-BUSINESS.md.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_TWITTER=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_VENUE_ADDRESS="Auditorio Arema Explanada, Puebla, Puebla, México"
NEXT_PUBLIC_VENUE_LAT=19.0414
NEXT_PUBLIC_VENUE_LNG=-98.2063
NEXT_PUBLIC_CONTACT_EMAIL=contacto@artaproducciones.com
NEXT_PUBLIC_CITY=Puebla
NEXT_PUBLIC_STATE=Puebla
# Comma-separated allowlist for the API's CORS + billing/invite links (defense-in-depth;
# browser traffic normally reaches the API same-origin via Traefik).
WEB_ORIGIN=https://artaproducciones.com,https://arta.artaproducciones.com,https://auditorio.artaproducciones.com
# Push de las apps móviles (FCM, Android e iOS): cuenta de servicio de Firebase
# en JSON de una línea o en base64. Vacío = sin push (el socket sigue avisando en vivo).
FIREBASE_SERVICE_ACCOUNT_JSON=
# Push del navegador (FCM web): app web registrada en Firebase console (Configuración del
# proyecto -> Tus apps -> Web) y VAPID key de Cloud Messaging -> Certificados push web.
# Se leen al construir la imagen web (rebuild tras cambiarlas). Vacías = función oculta.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ── Operación (deploy/OPERACION.md) ──────────────────────────────────────────
# Errores de la API a Sentry (crea un proyecto Node en sentry.io y pega el DSN). Vacío = apagado.
SENTRY_DSN=
SENTRY_ENV=production
# Avisos de caídas, disco y respaldos (deploy/monitor.sh, deploy/backup.sh):
# webhook de Slack/Discord/Google Chat, o https://ntfy.sh/<tema-secreto> para avisos al teléfono.
ALERT_WEBHOOK_URL=
# Respaldo nocturno: copia fuera del servidor con rclone (p. ej. b2:arta-respaldos o gdrive:ARTA/respaldos).
# Vacío = solo en este servidor (no protege si se pierde el VPS).
ARTA_BACKUP_REMOTE=
ARTA_BACKUP_DAYS=14
ARTA_BACKUP_REMOTE_DAYS=60
# update.sh no construye si el disco está arriba de este porcentaje (a 90 % se cae la BD).
ARTA_DEPLOY_MAX_DISK=80
# Swagger (/api/docs) está apagado en producción; 1 lo enciende a propósito.
SWAGGER_ENABLED=
# Eventos demo en el seed: apagados en producción; 1 los siembra a propósito.
SEED_DEMO=
