// ARTA · Prisma schema
// Dos entidades operativas: ARTA (productora) + EXPLANADA (Auditorio Arema)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Entidad (Arta vs Auditorio) ─────────────────────────────────────────────
enum EntityKey {
  ARTA
  EXPLANADA
}

enum EventStatus {
  DRAFT
  ACTIVE
  CLOSED
  CANCELLED
}

enum CampaignType {
  INTERNAL
  EXTERNAL
  NONE
}

enum PoStatus {
  DRAFT
  PENDING_AUTH
  AUTHORIZED
  PAID
  REJECTED
  CANCELLED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  PENDING_APPROVAL
  DONE
  BLOCKED
}

/// Ciclo de vida de un documento: checklist, corrida o documento del evento.
/// SEALED es de un solo sentido — solo dirección lo revierte, con motivo.
enum DocStatus {
  DRAFT
  REVIEW
  APPROVED
  SEALED
}

/// Qué tipo de documento versiona una `DocRevision`.
enum DocType {
  CHECKLIST
  FINANCE
  DOCUMENT
  FILE
}

enum ChecklistTemplateKey {
  EVENTO_GENERAL
  PRODUCCION
  HOSPEDAJE
  TRANSPORTACION
  RUEDA_PRENSA
  ARTES_SHOWS
  BOLETERA
  PENDONES
  ORDEN_COMPRA
  CATERING
  CORRIDA_FINANCIERA
  CAMPANA
  ANTICIPOS
  MANTENIMIENTO
  CUSTOM
}

enum OrgPlan {
  OPS
  ENTERPRISE
  TRIAL
}

// ─── Multi-org tenancy ───────────────────────────────────────────────────────
model Organization {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  name                 String
  plan                 OrgPlan  @default(OPS)
  active               Boolean  @default(true)
  /// Feature flags / branding
  settingsJson         Json?
  /// Stripe Billing (self-serve)
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  stripePriceId        String?
  billingStatus        String? // active | trialing | past_due | canceled | none
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users            User[]
  events           Event[]
  memberships      OrgMembership[]
  invites          OrgInvite[]
  webhookEndpoints WebhookEndpoint[]
  sharedFolders    SharedFolder[]
  tasks            TaskAssignment[]
  notifications    Notification[]
}

model OrgInvite {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  roleKey        String
  entities       EntityKey[]
  permissions    String[]     @default([])
  tokenHash      String       @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, email])
  @@index([email])
}

model OrgMembership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleKey        String // rol dentro del org (puede espejar User.roleKey)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

// ─── Usuarios / RBAC ─────────────────────────────────────────────────────────
model User {
  id               String        @id @default(cuid())
  email            String        @unique
  passwordHash     String
  fullName         String
  title            String?
  phone            String?
  active           Boolean       @default(true)
  roleKey          String // ver roles.ts
  /// Tenant primario (SaaS multi-org)
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id])
  /// Entidades a las que puede entrar: ["ARTA"], ["EXPLANADA"], ["ARTA","EXPLANADA"]
  entities         EntityKey[]
  /// Permisos finos opcionales (campaña, corrida, usuarios, studio…)
  permissions      String[]      @default([])
  /// Anti-brute force persistente
  failedLoginCount Int           @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  /// 2FA TOTP
  totpSecret       String?
  totpEnabled      Boolean       @default(false)
  totpVerifiedAt   DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  eventsCreated       Event[]                    @relation("EventCreator")
  checklistEdits      ChecklistInstance[]        @relation("ChecklistLastEditor")
  checklistDelivered  ChecklistInstance[]        @relation("ChecklistDelivered")
  checklistAuthorized ChecklistInstance[]        @relation("ChecklistAuthorized")
  checklistVersions   ChecklistVersion[]
  templateVersions    ChecklistTemplateVersion[]
  assignedTasks       TaskAssignment[]           @relation("TaskAssignee")
  createdTasks        TaskAssignment[]           @relation("TaskCreator")
  filesEdited         EventFile[]                @relation("FileEditor")
  documentsCreated    EventDocument[]            @relation("DocumentCreator")
  documentsEdited     EventDocument[]            @relation("DocumentEditor")
  notifications       Notification[]             @relation("NotificationRecipient")
  notificationsSent   Notification[]             @relation("NotificationActor")
  auditLogs           AuditLog[]
  purchaseOrders      PurchaseOrder[]            @relation("PoCreator")
  poAuthorizations    PurchaseOrder[]            @relation("PoAuthorizer")
  paymentsUploaded    PaymentProof[]
  taskEvidences       TaskEvidence[]
  taskActivities      TaskActivity[]
  checklistsCreated   ChecklistInstance[]        @relation("ChecklistCreator")
  financeRunsCreated  FinanceRun[]               @relation("FinanceCreator")
  financeRunsEdited   FinanceRun[]               @relation("FinanceEditor")
  docRevisions        DocRevision[]              @relation("RevisionAuthor")
  tasksApproved       TaskAssignment[]           @relation("TaskApprover")
  tasksRejected       TaskAssignment[]           @relation("TaskRejecter")
  sessions            UserSession[]
  handoffs            AuthHandoff[]
  memberships         OrgMembership[]
  totpChallenges      TotpChallenge[]

  @@index([organizationId])
}

// ─── Eventos ─────────────────────────────────────────────────────────────────
model Event {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  entity         EntityKey
  name           String
  artist         String?
  promoter       String?
  venue          String?
  city           String?
  startsAt       DateTime?
  endsAt         DateTime?
  status         EventStatus   @default(DRAFT)
  campaignType   CampaignType  @default(NONE)
  notes          String?
  createdById    String?
  createdBy      User?         @relation("EventCreator", fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  checklists      ChecklistInstance[]
  purchaseOrders  PurchaseOrder[]
  financeRuns     FinanceRun[]
  ticketingSetups TicketingSetup[]
  tasks           TaskAssignment[]
  files           EventFile[]
  campaign        Campaign?
  sponsors        Sponsor[]
  vendorPins      VendorPin[]
  documents       EventDocument[]
  docRevisions    DocRevision[]

  @@index([organizationId, entity])
  @@index([organizationId, status, startsAt])
  @@index([entity, startsAt])
}

// ─── Patrocinadores ──────────────────────────────────────────────────────────
model Sponsor {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name         String
  contact      String?
  contribution String?
  amount       Decimal? @db.Decimal(14, 2)
  notes        String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([eventId])
}

// ─── Plantillas de checklist (jerárquicas) ───────────────────────────────────
model ChecklistTemplate {
  id          String               @id @default(cuid())
  key         ChecklistTemplateKey
  name        String
  description String?
  /// Aplica a qué entidad(es); vacío = ambas
  entities    EntityKey[]
  /// Árbol de secciones/ítems en JSON (labels, tipos, hijos)
  schemaJson  Json
  version     Int                  @default(1)
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  instances ChecklistInstance[]
  versions  ChecklistTemplateVersion[]
}

model ChecklistTemplateVersion {
  id         String            @id @default(cuid())
  templateId String
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  schemaJson Json
  version    Int
  note       String?
  editedById String?
  editedBy   User?             @relation(fields: [editedById], references: [id])
  createdAt  DateTime          @default(now())

  @@index([templateId])
}

model ChecklistInstance {
  id                  String            @id @default(cuid())
  eventId             String
  event               Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  templateId          String
  template            ChecklistTemplate @relation(fields: [templateId], references: [id])
  title               String
  /// Datos llenados (mismo shape que schemaJson) — plantilla editable en web
  dataJson            Json
  progressPct         Int               @default(0)
  lastEditedById      String?
  lastEditedBy        User?             @relation("ChecklistLastEditor", fields: [lastEditedById], references: [id])
  lastEditedAt        DateTime?
  /// PDF generado desde la plantilla (se regenera al guardar)
  pdfUrl              String?
  pdfGeneratedAt      DateTime?
  /// Dónde quedó cada dato dentro del PDF, para escribir encima del documento
  pdfFieldsJson       Json?
  /// Firma digital "Entregado"
  deliveredAt         DateTime?
  deliveredById       String?
  deliveredBy         User?             @relation("ChecklistDelivered", fields: [deliveredById], references: [id])
  deliveredSignature  Json?
  /// Firma digital "Autorizado"
  authorizedAt        DateTime?
  authorizedById      String?
  authorizedBy        User?             @relation("ChecklistAuthorized", fields: [authorizedById], references: [id])
  authorizedSignature Json?
  /// Borrador → Revisión → Aprobado → Sellado
  status              DocStatus         @default(DRAFT)
  /// Contador de revisiones Y token de bloqueo optimista: se incrementa en el
  /// mismo UPDATE que escribe los datos, así dos guardados concurrentes no
  /// pueden pisarse en silencio.
  revision            Int               @default(0)
  createdById         String?
  createdBy           User?             @relation("ChecklistCreator", fields: [createdById], references: [id])
  submittedById       String?
  submittedAt         DateTime?
  approvedById        String?
  approvedAt          DateTime?
  sealedById          String?
  sealedAt            DateTime?
  /// Obligatorio al reabrir algo sellado: queda en el historial.
  reopenReason        String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  versions   ChecklistVersion[]
  files      EventFile[]
  signatures DigitalSignature[]

  @@index([eventId])
  @@index([templateId])
}

model DigitalSignature {
  id           String            @id @default(cuid())
  checklistId  String
  checklist    ChecklistInstance @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  kind         String // ENTREGADO | AUTORIZADO
  signerName   String
  signerUserId String?
  imageDataUrl String            @db.Text
  signedAt     DateTime          @default(now())
  ip           String?
  userAgent    String?
  metaJson     Json?

  @@index([checklistId, kind])
}

model ChecklistVersion {
  id         String            @id @default(cuid())
  instanceId String
  instance   ChecklistInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  dataJson   Json
  editedById String?
  editedBy   User?             @relation(fields: [editedById], references: [id])
  note       String?
  createdAt  DateTime          @default(now())

  @@index([instanceId])
}

// ─── Órdenes de compra ───────────────────────────────────────────────────────
model PurchaseOrder {
  id             String    @id @default(cuid())
  eventId        String
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rubro          String // audio, luces, hospedaje, catering…
  vendorName     String?
  description    String?
  amount         Decimal   @db.Decimal(14, 2)
  currency       String    @default("MXN")
  status         PoStatus  @default(DRAFT)
  createdById    String?
  createdBy      User?     @relation("PoCreator", fields: [createdById], references: [id])
  authorizedById String?
  authorizedBy   User?     @relation("PoAuthorizer", fields: [authorizedById], references: [id])
  authorizedAt   DateTime?
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lines  PurchaseOrderLine[]
  proofs PaymentProof[]

  @@index([eventId])
  @@index([eventId, status])
}

model PurchaseOrderLine {
  id        String        @id @default(cuid())
  orderId   String
  order     PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  concept   String
  qty       Decimal       @default(1) @db.Decimal(12, 2)
  unitPrice Decimal       @db.Decimal(14, 2)
  total     Decimal       @db.Decimal(14, 2)

  @@index([orderId])
}

model PaymentProof {
  id              String         @id @default(cuid())
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  eventId         String?
  label           String?
  fileUrl         String
  amount          Decimal?       @db.Decimal(14, 2)
  uploadedById    String?
  uploadedBy      User?          @relation(fields: [uploadedById], references: [id])
  createdAt       DateTime       @default(now())

  @@index([eventId])
  @@index([purchaseOrderId])
}

// ─── Corrida financiera ──────────────────────────────────────────────────────
model FinanceRun {
  id             String    @id @default(cuid())
  eventId        String
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title          String    @default("Corrida financiera")
  /// Filas/budget embebido (compatible con Excel import)
  dataJson       Json
  /// Derivado de `status` y del ciclo de vida del evento. Se conserva porque
  /// `events.controller` todavía lo escribe al cerrar/reabrir; desaparece en
  /// una migración posterior, cuando todo pase por el guard de estado.
  locked         Boolean   @default(false)
  status         DocStatus @default(DRAFT)
  revision       Int       @default(0)
  createdById    String?
  createdBy      User?     @relation("FinanceCreator", fields: [createdById], references: [id])
  lastEditedById String?
  lastEditedBy   User?     @relation("FinanceEditor", fields: [lastEditedById], references: [id])
  lastEditedAt   DateTime?
  sealedById     String?
  sealedAt       DateTime?
  reopenReason   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([eventId])
}

// ─── Campaña publicitaria ────────────────────────────────────────────────────
model Campaign {
  id           String       @id @default(cuid())
  eventId      String       @unique
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type         CampaignType @default(INTERNAL)
  authorized   Boolean      @default(false)
  authorizedAt DateTime?
  notes        String?
  dataJson     Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// ─── Boletera ────────────────────────────────────────────────────────────────
model TicketingSetup {
  id        String    @id @default(cuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  boletera  String // Arema | eTicket | custom display name
  logoUrl   String? // /uploads/... used in checklist PDFs
  holdUntil DateTime?
  artist    String?
  promoter  String?
  venue     String?
  /// Zonas: [{zona, aforo, precio}]
  zonesJson Json
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([eventId])
}

// ─── Tareas ──────────────────────────────────────────────────────────────────
model TaskAssignment {
  id             String        @id @default(cuid())
  /// Opcional: una tarea puede ser de apoyo entre personas, sin evento detrás
  eventId        String?
  event          Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Tenant de la tarea (se copia del evento cuando lo hay)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  assigneeId     String?
  assignee       User?         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  /// Quién pidió el apoyo — recibe el aviso cuando se cierra
  createdById    String?
  createdBy      User?         @relation("TaskCreator", fields: [createdById], references: [id])
  title          String
  module         String?
  detail         String?
  status         TaskStatus    @default(OPEN)
  dueAt          DateTime?
  /// Cuando el asignado abrió «Mis tareas» / vio la actividad
  seenAt         DateTime?
  /// Entrega con evidencia — espera visto bueno de quien pidió
  submittedAt    DateTime?
  completionNote String?
  approvedById   String?
  approvedBy     User?         @relation("TaskApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  rejectedById   String?
  rejectedBy     User?         @relation("TaskRejecter", fields: [rejectedById], references: [id])
  rejectedAt     DateTime?
  rejectionNote  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  evidences TaskEvidence[]
  activities TaskActivity[]

  @@index([assigneeId, status])
  @@index([organizationId, status])
  @@index([eventId])
  @@index([createdById, status])
}

model TaskEvidence {
  id           String         @id @default(cuid())
  taskId       String
  task         TaskAssignment @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileUrl      String
  label        String?
  note         String?
  uploadedById String?
  uploadedBy   User?          @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime       @default(now())

  @@index([taskId])
}

model TaskActivity {
  id        String         @id @default(cuid())
  taskId    String
  task      TaskAssignment @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?          @relation(fields: [actorId], references: [id])
  action    String
  detail    String?
  metaJson  Json?
  createdAt DateTime       @default(now())

  @@index([taskId, createdAt])
}

// ─── Notificaciones dentro de la plataforma ──────────────────────────────────
model Notification {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  /// task.assigned | task.reassigned | task.done | task.due …
  type           String
  title          String
  body           String?
  /// Ruta interna del panel a la que lleva el aviso
  linkUrl        String?
  actorId        String?
  actor          User?         @relation("NotificationActor", fields: [actorId], references: [id])
  entity         EntityKey?
  readAt         DateTime?
  createdAt      DateTime      @default(now())

  @@index([userId, readAt, createdAt])
  @@index([organizationId, createdAt])
}

// ─── Archivos / Excel-PDF embebidos ──────────────────────────────────────────
model EventFile {
  id          String             @id @default(cuid())
  eventId     String?
  event       Event?             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  checklistId String?
  checklist   ChecklistInstance? @relation(fields: [checklistId], references: [id], onDelete: SetNull)
  fileName    String
  mimeType    String
  url         String
  sizeBytes   Int?
  kind        String? // pdf | excel | image | other
  /// Sección del evento a la que pertenece: campaign | finance | general …
  module      String?
  /// Sube cada vez que alguien guarda el archivo editado desde el panel
  version     Int                @default(1)
  updatedById String?
  updatedBy   User?              @relation("FileEditor", fields: [updatedById], references: [id])
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @default(now()) @updatedAt

  @@index([eventId, module])
}

/// Documento editable tipo Word: se escribe en el panel y se descarga en PDF.
model EventDocument {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Sección del evento: campaign | general …
  module       String?
  title        String
  /// Bloques: [{ type: 'h1'|'h2'|'p'|'bullet'|'divider', text: string }]
  blocksJson   Json
  version      Int      @default(1)
  /// Último PDF exportado, para no regenerarlo si nada cambió
  pdfUrl       String?
  pdfVersion   Int?
  /// Cuando el documento nació de un PDF importado
  sourceFileId String?
  createdById  String?
  createdBy    User?    @relation("DocumentCreator", fields: [createdById], references: [id])
  updatedById  String?
  updatedBy    User?    @relation("DocumentEditor", fields: [updatedById], references: [id])
  status       DocStatus @default(DRAFT)
  revision     Int       @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([eventId, module])
}

// ─── Studio (CMS pages) ──────────────────────────────────────────────────────
model PageContent {
  id          String    @id @default(cuid())
  entity      EntityKey
  sectionKey  String
  title       String?
  contentJson Json
  published   Boolean   @default(false)
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  @@unique([entity, sectionKey])
}

model HeroSlide {
  id        String    @id @default(cuid())
  entity    EntityKey @default(ARTA)
  title     String?
  subtitle  String?
  imageUrl  String
  ctaLabel  String?
  ctaHref   String?
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model NewsPost {
  id          String    @id @default(cuid())
  entity      EntityKey @default(ARTA)
  slug        String
  title       String
  excerpt     String?
  body        String?
  coverUrl    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([entity, slug])
  @@index([entity, published])
}

// ─── Carpetas generales (ACL ligero) ─────────────────────────────────────────
model SharedFolder {
  id             String       @id @default(cuid())
  organizationId String       @default("org_arta_internal")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity         EntityKey
  name           String
  description    String?
  /// Roles que pueden ver/editar (vacío = todos los de la entidad)
  allowedRoles   String[]
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  files          SharedFile[]

  @@index([organizationId, entity])
  @@index([entity])
}

model SharedFile {
  id           String       @id @default(cuid())
  folderId     String
  folder       SharedFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String?
  url          String
  sizeBytes    Int?
  uploadedById String?
  createdAt    DateTime     @default(now())

  @@index([folderId])
}

// ─── Acceso vendor por PIN ───────────────────────────────────────────────────
model VendorPin {
  id          String    @id @default(cuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  label       String
  pinHash     String
  /// scopes: files | checklists | hospitality
  scopes      String[]
  expiresAt   DateTime?
  active      Boolean   @default(true)
  createdById String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?

  @@index([eventId])
}

// ─── Audit ───────────────────────────────────────────────────────────────────
model AuditLog {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  /// Propio, no inferido por el autor: los registros de sistema (`userId`
  /// nulo) eran invisibles para todos salvo super_admin.
  organizationId String?
  action         String
  resource       String
  resourceId     String?
  metaJson       Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([resource, resourceId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
}

/// Historial unificado de los documentos del evento.
///
/// Una sola tabla para checklist, corrida, documento y archivo: comparten
/// ciclo de vida, visor de diff y lista de revisiones. Cuatro tablas paralelas
/// obligarían a cuadruplicar servicio, endpoint y panel. El repo ya usa este
/// patrón en `AuditLog(resource, resourceId)`.
///
/// `eventId` SÍ es FK real: sin ella, borrar un evento dejaría cientos de
/// revisiones huérfanas para siempre. `(docType, docId)` es la clave lógica.
model DocRevision {
  id             String       @id @default(cuid())
  organizationId String
  eventId        String
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  docType        DocType
  docId          String
  /// Consecutivo por documento; sale del contador `revision` del padre.
  revision       Int
  /// Estado completo tras el cambio. Es la VERDAD.
  snapshotJson   Json?
  /// Qué cambió respecto a la revisión anterior. Caché regenerable a partir de
  /// los snapshots: si algún día discrepan, manda `snapshotJson`.
  diffJson       Json?
  /// Binarios: dónde quedó ESA versión del archivo, y su huella.
  fileUrl        String?
  fileHash       String?
  sizeBytes      Int?
  fromStatus     DocStatus?
  toStatus       DocStatus?
  note           String?
  authorId       String?
  author         User?        @relation("RevisionAuthor", fields: [authorId], references: [id])
  ip             String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  @@unique([docType, docId, revision])
  @@index([organizationId, createdAt])
  @@index([eventId, createdAt])
  @@index([authorId, createdAt])
  @@index([docType, docId, createdAt])
}

// ─── Identity: sesiones activas ──────────────────────────────────────────────
model UserSession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Hash del JWT jti o fingerprint de token (no guardar JWT en claro)
  tokenHash   String
  userAgent   String?
  ip          String?
  deviceLabel String?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  revokedAt   DateTime?
  expiresAt   DateTime

  @@index([userId, revokedAt])
  @@index([tokenHash])
}

/// One-time cross-host SSO (reemplaza JWT en query string)
model AuthHandoff {
  id        String    @id @default(cuid())
  codeHash  String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity    EntityKey
  path      String    @default("/dashboard")
  /// JWT emitido al consumir (firmado al crear, short TTL)
  token     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ─── Integraciones ───────────────────────────────────────────────────────────
model WebhookEndpoint {
  id             String            @id @default(cuid())
  organizationId String            @default("org_arta_internal")
  organization   Organization      @relation(fields: [organizationId], references: [id])
  name           String
  url            String
  secret         String
  events         String[] // event.created, po.status, checklist.signed, automation.alert…
  active         Boolean           @default(true)
  entity         EntityKey? // null = ambas
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deliveries     WebhookDelivery[]

  @@index([organizationId, active])
}

model WebhookDelivery {
  id          String          @id @default(cuid())
  endpointId  String
  endpoint    WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event       String
  payloadJson Json
  statusCode  Int?
  success     Boolean         @default(false)
  error       String?
  attempts    Int             @default(1)
  createdAt   DateTime        @default(now())

  @@index([endpointId, createdAt])
}

/// Challenge temporal post-password cuando 2FA está activo
model TotpChallenge {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Cola durable ligera (sin Redis): digests, retries, jobs
model JobRun {
  id             String    @id @default(cuid())
  organizationId String?
  kind           String // digest.daily | automation.scan | webhook.retry
  status         String // pending | running | done | failed
  payloadJson    Json?
  resultJson     Json?
  attempts       Int       @default(0)
  runAt          DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  error          String?
  createdAt      DateTime  @default(now())

  @@index([kind, status, runAt])
  @@index([organizationId, createdAt])
}

model NotificationOutbox {
  id             String    @id @default(cuid())
  organizationId String?
  channel        String // email | webhook | inapp
  toAddr         String
  subject        String
  bodyText       String    @db.Text
  metaJson       Json?
  status         String    @default("pending") // pending | sent | failed
  attempts       Int       @default(0)
  sentAt         DateTime?
  error          String?
  createdAt      DateTime  @default(now())

  @@index([status, createdAt])
  @@index([organizationId, createdAt])
}
