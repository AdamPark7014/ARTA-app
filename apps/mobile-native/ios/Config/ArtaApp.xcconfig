// Firma del target ArtaApp. Por defecto, automática y sin equipo (sirve para
// compilar en simulador). El flujo de TestFlight escribe
// ArtaApp.signing.xcconfig (ignorado por git) con firma manual y su perfil.
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =
// Identidad de firma (project.yml la usa en el target). TestFlight la cambia a Apple Distribution.
ARTA_CODE_SIGN_IDENTITY = Apple Development

#include? "ArtaApp.signing.xcconfig"
