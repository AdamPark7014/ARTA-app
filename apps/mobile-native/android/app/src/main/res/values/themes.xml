<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Arta" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/arta_bg</item>
        <item name="android:statusBarColor">@color/arta_bg</item>
        <item name="android:navigationBarColor">@color/arta_bg</item>
        <item name="colorPrimary">@color/arta_gold</item>
    </style>

    <style name="Theme.Arta.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/arta_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Arta</item>
    </style>
</resources>
