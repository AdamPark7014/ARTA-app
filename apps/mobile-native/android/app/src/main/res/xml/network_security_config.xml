<?xml version="1.0" encoding="utf-8"?>
<!--
    Release / producción: solo HTTPS, sin excepciones. La excepción para el API
    local (10.0.2.2 / localhost) vive en src/debug/res/xml/ y solo entra en debug:
    un release que la llevara dejaría hablar en claro con cualquier red que se
    hiciera pasar por esos nombres.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
